# Database Configuration
# For local development, use a local PostgreSQL database
# For production on Vercel, use a cloud database (Neon, Supabase, Railway, etc.)
DATABASE_URL=postgresql://user:password@localhost:5432/awe_electronics

# Security Configuration
# Generate a secure secret key with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-replace-with-actual-secret

# JWT Configuration (Optional - defaults are in config.py)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
